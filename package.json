{
  "name": "@e-watson/axon",
  "version": "0.1.0",
  "description": "Minimal HTTP pipeline framework for Node.js",
  "keywords": [
    "node",
    "http",
    "middleware",
    "router",
    "framework"
  ],
  "homepage": "https://github.com/e-Watson-dot-ua/axon#readme",
  "bugs": { "url": "https://github.com/e-Watson-dot-ua/axon/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-Watson-dot-ua/axon.git"
  },
  "license": "MIT",
  "author": {
    "name": "e-Watson",
    "url": "https://github.com/e-Watson-dot-ua"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [ "src", "types" ],
  "sideEffects": false,
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "bench": "node benchmarks/run.js",
    "prepublishOnly": "npm run lint && npm test && npm run build:types"
  },
  "peerDependencies": {
    "@e-watson/axon-logger": ">=0.0.1"
  },
  "peerDependenciesMeta": {
    "@e-watson/axon-logger": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": ">=18.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
